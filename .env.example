# =============================================================================
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#
#   cp .env.example .env
#
# On a hosting platform, set these as environment variables in the dashboard
# instead of shipping a .env file. On Railway: Variables tab, or `railway
# variables --set KEY=value`.
#
# Nothing here has a default that silently works. If a required variable is
# missing, `npm run preflight` tells you which one and why, and the run refuses
# to start rather than doing something surprising with a fallback.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. MODEL ACCESS — required. Pick exactly ONE of the two.
# -----------------------------------------------------------------------------

# Option A: Anthropic API key. Pay-as-you-go, billed per token. Simplest for a
# server; works everywhere; no interactive login. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Option B: use an existing Claude subscription (Pro/Max/Team) instead of API
# billing. Generate a long-lived token on a machine where you are logged in:
#     claude setup-token
# then paste it here. Check your plan's terms before running it unattended on a
# server — subscription usage limits are not designed for continuous automation.
# CLAUDE_CODE_OAUTH_TOKEN=

# Model for the daily run. Leave unset for the default.
# ANTHROPIC_MODEL=


# -----------------------------------------------------------------------------
# 2. OUTREACH PLATFORM — required. This executes the touches and owns the
#    approval queue that gates every send.
# -----------------------------------------------------------------------------

# Static bearer token for the outreach MCP. This is the headless path and the
# one to use on a server.
FT_MCP_TOKEN=

# Override the MCP endpoint only if you were given a different one.
# FT_MCP_URL=https://mcp.firsttouch.ai


# -----------------------------------------------------------------------------
# 3. CRM — required. Source of truth for accounts, contacts and ownership.
# -----------------------------------------------------------------------------

# HubSpot private-app token. Create at Settings > Integrations > Private Apps.
# Required scopes are listed in docs/configuration.md — grant read scopes first
# and add write scopes only when you turn on CRM logging.
HUBSPOT_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# 4. DIGEST DELIVERY — optional but strongly recommended.
#
# The agent POSTS a digest to Slack. It does NOT open any inbound endpoint and
# does NOT receive Slack events, so there is nothing here for an attacker to
# reach. Approve or reject in your outreach platform's task queue, which is the
# source of truth.
# -----------------------------------------------------------------------------

# Slack bot token (xoxb-...). Needs only `chat:write`. Invite the bot to your
# approvals channel. Leave blank to skip Slack entirely and rely on the queue.
SLACK_BOT_TOKEN=

# Channel for the daily digest. Overrides client.digest.slack_channel in config.
# SLACK_CHANNEL=#pipeline-approvals


# -----------------------------------------------------------------------------
# 5. OPTIONAL RESEARCH ENRICHMENT
#
# Every one of these degrades gracefully. Missing key = that signal is skipped
# and the run says so in the report. None are required.
# -----------------------------------------------------------------------------

# Web search for company signals (funding, hiring, news).
# SERPER_API_KEY=

# Ad-library signal — is this company running paid acquisition right now?
# SCRAPECREATORS_API_KEY=


# -----------------------------------------------------------------------------
# 6. RUNTIME
# -----------------------------------------------------------------------------

# Which config file in config/ to run. Lets one deployment serve several
# configurations if you ever need that.
TENANT=tenant

# Where run state lives. On an ephemeral host (Railway, Fly, Render) this MUST
# point at a mounted volume, or dedupe and the re-work cooldown reset on every
# deploy and people get contacted twice. See docs/deploy-railway.md.
STATE_DIR=./state

# Set to 1 to research and draft WITHOUT creating anything in the outreach
# platform. Costs model tokens only. Use this for your first runs.
DRY_RUN=1
