# FirstTouch Agent — copy to .env and fill in.
# Every value here can also be set as a real environment variable (a container
# should do exactly that); real env vars win over this file.

# --- Slack (from your app; see README step 1) --------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Model access ------------------------------------------------------------
# Subscription (Pro/Max/Team): run `claude setup-token` where you're logged in
# and paste the result. Pay-as-you-go: set ANTHROPIC_API_KEY instead. Running
# locally where `claude` is already logged in, both may stay unset.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# The model every session runs on. Opus 5 unless you have a reason: the work
# is judgement-heavy, and a weaker model doesn't fail loudly — it drafts worse.
# AGENT_MODEL=claude-opus-5

# --- HubSpot (private app token; see README step 4) --------------------------
HUBSPOT_ACCESS_TOKEN=

# --- Optional ----------------------------------------------------------------
# Timezone for schedules.json (IANA name). Defaults to the machine's.
# AGENT_TZ=America/New_York

# Extra Slack user ids (comma-separated) allowed to talk to the agent besides
# the operator who claimed it.
# ALLOWED_SLACK_USERS=U0123ABCD,U0456EFGH

# Where the host keeps its small state files (operator, sessions, uploads).
# In a container, mount a volume here.
# STATE_DIR=./state
